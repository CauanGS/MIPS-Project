`timescale 1 ps/ 1 ps
module processador_mips_vlg_sample_tst(
	INPUTA,
	INPUTB,
	sampler_tx
);
input [31:0] INPUTA;
input [31:0] INPUTB;
output sampler_tx;

reg sample;
time current_time;
always @(INPUTA or INPUTB)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

