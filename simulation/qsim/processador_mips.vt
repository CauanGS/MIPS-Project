// generate trigger
always @(BranchResult_expected or BranchResult or BranchSinal_expected or BranchSinal or ENTRADA_SHIFT_LEFT_expected or ENTRADA_SHIFT_LEFT or ENTRADA_ULA1_expected or ENTRADA_ULA1 or ENTRADA_ULA2_expected or ENTRADA_ULA2 or INSTR_expected or INSTR or JumpSinal_expected or JumpSinal or PC_expected or PC or RD1_expected or RD1 or RD2_expected or RD2 or RESULTADO_expected or RESULTADO or SAIDA_EXTENSOR_expected or SAIDA_EXTENSOR or SAIDA_SHIFT2L_expected or SAIDA_SHIFT2L)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected BranchResult = %b | expected BranchSinal = %b | expected ENTRADA_SHIFT_LEFT = %b | expected ENTRADA_ULA1 = %b | expected ENTRADA_ULA2 = %b | expected INSTR = %b | expected JumpSinal = %b | expected PC = %b | expected RD1 = %b | expected RD2 = %b | expected RESULTADO = %b | expected SAIDA_EXTENSOR = %b | expected SAIDA_SHIFT2L = %b | ",BranchResult_expected_prev,BranchSinal_expected_prev,ENTRADA_SHIFT_LEFT_expected_prev,ENTRADA_ULA1_expected_prev,ENTRADA_ULA2_expected_prev,INSTR_expected_prev,JumpSinal_expected_prev,PC_expected_prev,RD1_expected_prev,RD2_expected_prev,RESULTADO_expected_prev,SAIDA_EXTENSOR_expected_prev,SAIDA_SHIFT2L_expected_prev);
	$display("| real BranchResult = %b | real BranchSinal = %b | real ENTRADA_SHIFT_LEFT = %b | real ENTRADA_ULA1 = %b | real ENTRADA_ULA2 = %b | real INSTR = %b | real JumpSinal = %b | real PC = %b | real RD1 = %b | real RD2 = %b | real RESULTADO = %b | real SAIDA_EXTENSOR = %b | real SAIDA_SHIFT2L = %b | ",BranchResult_prev,BranchSinal_prev,ENTRADA_SHIFT_LEFT_prev,ENTRADA_ULA1_prev,ENTRADA_ULA2_prev,INSTR_prev,JumpSinal_prev,PC_prev,RD1_prev,RD2_prev,RESULTADO_prev,SAIDA_EXTENSOR_prev,SAIDA_SHIFT2L_prev);
`endif
	if (
		( BranchResult_expected_prev !== 1'bx ) && ( BranchResult_prev !== BranchResult_expected_prev )
		&& ((BranchResult_expected_prev !== last_BranchResult_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port BranchResult :: @time = %t",  $realtime);
		$display ("     Expected value = %b", BranchResult_expected_prev);
		$display ("     Real value = %b", BranchResult_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_BranchResult_exp = BranchResult_expected_prev;
	end
	if (
		( BranchSinal_expected_prev !== 1'bx ) && ( BranchSinal_prev !== BranchSinal_expected_prev )
		&& ((BranchSinal_expected_prev !== last_BranchSinal_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port BranchSinal :: @time = %t",  $realtime);
		$display ("     Expected value = %b", BranchSinal_expected_prev);
		$display ("     Real value = %b", BranchSinal_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_BranchSinal_exp = BranchSinal_expected_prev;
	end
	if (
		( ENTRADA_SHIFT_LEFT_expected_prev[0] !== 1'bx ) && ( ENTRADA_SHIFT_LEFT_prev[0] !== ENTRADA_SHIFT_LEFT_expected_prev[0] )
		&& ((ENTRADA_SHIFT_LEFT_expected_prev[0] !== last_ENTRADA_SHIFT_LEFT_exp[0]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port ENTRADA_SHIFT_LEFT[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", ENTRADA_SHIFT_LEFT_expected_prev);
		$display ("     Real value = %b", ENTRADA_SHIFT_LEFT_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_ENTRADA_SHIFT_LEFT_exp[0] = ENTRADA_SHIFT_LEFT_expected_prev[0];
	end
	if (
		( ENTRADA_SHIFT_LEFT_expected_prev[1] !== 1'bx ) && ( ENTRADA_SHIFT_LEFT_prev[1] !== ENTRADA_SHIFT_LEFT_expected_prev[1] )
		&& ((ENTRADA_SHIFT_LEFT_expected_prev[1] !== last_ENTRADA_SHIFT_LEFT_exp[1]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port ENTRADA_SHIFT_LEFT[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", ENTRADA_SHIFT_LEFT_expected_prev);
		$display ("     Real value = %b", ENTRADA_SHIFT_LEFT_prev);
