initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module processador_mips_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLK;
reg RESET;
// wires                                               
wire BranchResult;
wire BranchSinal;
wire [31:0] ENTRADA_SHIFT_LEFT;
wire [31:0] ENTRADA_ULA1;
wire [31:0] ENTRADA_ULA2;
wire [31:0] INSTR;
wire JumpSinal;
wire [31:0] PC;
wire [31:0] RD1;
wire [31:0] RD2;
wire [31:0] RESULTADO;
wire [31:0] SAIDA_EXTENSOR;
wire [31:0] SAIDA_SHIFT2L;

wire sampler;                             

// assign statements (if any)                          
processador_mips i1 (
// port map - connection between master ports and signals/registers   
	.BranchResult(BranchResult),
	.BranchSinal(BranchSinal),
	.CLK(CLK),
	.ENTRADA_SHIFT_LEFT(ENTRADA_SHIFT_LEFT),
	.ENTRADA_ULA1(ENTRADA_ULA1),
	.ENTRADA_ULA2(ENTRADA_ULA2),
	.INSTR(INSTR),
	.JumpSinal(JumpSinal),
	.PC(PC),
	.RD1(RD1),
	.RD2(RD2),
	.RESET(RESET),
	.RESULTADO(RESULTADO),
	.SAIDA_EXTENSOR(SAIDA_EXTENSOR),
	.SAIDA_SHIFT2L(SAIDA_SHIFT2L)
);

// CLK
always
begin
	CLK = 1'b0;
	CLK = #5000 1'b1;
	#5000;
end 

// RESET
initial
begin
	RESET = 1'b0;
end 

processador_mips_vlg_sample_tst tb_sample (
	.CLK(CLK),
	.RESET(RESET),
	.sampler_tx(sampler)
);

processador_mips_vlg_check_tst tb_out(
	.BranchResult(BranchResult),
	.BranchSinal(BranchSinal),
	.ENTRADA_SHIFT_LEFT(ENTRADA_SHIFT_LEFT),
	.ENTRADA_ULA1(ENTRADA_ULA1),
	.ENTRADA_ULA2(ENTRADA_ULA2),
	.INSTR(INSTR),
	.JumpSinal(JumpSinal),
	.PC(PC),
	.RD1(RD1),
	.RD2(RD2),
	.RESULTADO(RESULTADO),
	.SAIDA_EXTENSOR(SAIDA_EXTENSOR),
	.SAIDA_SHIFT2L(SAIDA_SHIFT2L),
	.sampler_rx(sampler)
);
endmodule

