		$display ("ERROR! Vector Mismatch for output port RegWrite :: @time = %t",  $realtime);
		$display ("     Expected value = %b", RegWrite_expected_prev);
		$display ("     Real value = %b", RegWrite_prev);
		nummismatches = nummismatches + 1;
		on_first_change[18] = 1'b0;
		last_RegWrite_exp = RegWrite_expected_prev;
	end
	if (
		( ULAsrc_expected_prev !== 1'bx ) && ( ULAsrc_prev !== ULAsrc_expected_prev )
		&& ((ULAsrc_expected_prev !== last_ULAsrc_exp) ||
			on_first_change[19])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port ULAsrc :: @time = %t",  $realtime);
		$display ("     Expected value = %b", ULAsrc_expected_prev);
		$display ("     Real value = %b", ULAsrc_prev);
		nummismatches = nummismatches + 1;
		on_first_change[19] = 1'b0;
		last_ULAsrc_exp = ULAsrc_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module processador_mips_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLK_MANUAL;
reg RESET;
// wires                                               
wire BranchResult;
wire BranchSinal;
wire [31:0] ENTRADA_ULA1;
wire [31:0] ENTRADA_ULA2;
wire [6:0] HEX0;
wire [6:0] HEX1;
wire [6:0] HEX2;
wire [6:0] HEX3;
wire [6:0] HEX4;
wire [6:0] HEX5;
wire [6:0] HEX6;
wire [6:0] HEX7;
wire [31:0] INSTR;
wire JumpSinal;
wire MemToReg;
wire MemWrite;
wire RegDest;
wire RegWrite;
wire ULAsrc;

wire sampler;                             

// assign statements (if any)                          
processador_mips i1 (
// port map - connection between master ports and signals/registers   
	.BranchResult(BranchResult),
	.BranchSinal(BranchSinal),
	.CLK_MANUAL(CLK_MANUAL),
	.ENTRADA_ULA1(ENTRADA_ULA1),
	.ENTRADA_ULA2(ENTRADA_ULA2),
	.HEX0(HEX0),
	.HEX1(HEX1),
	.HEX2(HEX2),
	.HEX3(HEX3),
	.HEX4(HEX4),
	.HEX5(HEX5),
	.HEX6(HEX6),
	.HEX7(HEX7),
	.INSTR(INSTR),
	.JumpSinal(JumpSinal),
	.MemToReg(MemToReg),
	.MemWrite(MemWrite),
	.RegDest(RegDest),
	.RegWrite(RegWrite),
	.RESET(RESET),
	.ULAsrc(ULAsrc)
);

// CLK_MANUAL
always
begin
	CLK_MANUAL = 1'b0;
	CLK_MANUAL = #5000 1'b1;
	#5000;
end 

// RESET
initial
begin
	RESET = 1'b1;
end 

processador_mips_vlg_sample_tst tb_sample (
	.CLK_MANUAL(CLK_MANUAL),
	.RESET(RESET),
	.sampler_tx(sampler)
);

processador_mips_vlg_check_tst tb_out(
	.BranchResult(BranchResult),
	.BranchSinal(BranchSinal),
	.ENTRADA_ULA1(ENTRADA_ULA1),
	.ENTRADA_ULA2(ENTRADA_ULA2),
	.HEX0(HEX0),
	.HEX1(HEX1),
	.HEX2(HEX2),
	.HEX3(HEX3),
	.HEX4(HEX4),
	.HEX5(HEX5),
	.HEX6(HEX6),
	.HEX7(HEX7),
	.INSTR(INSTR),
	.JumpSinal(JumpSinal),
	.MemToReg(MemToReg),
	.MemWrite(MemWrite),
	.RegDest(RegDest),
	.RegWrite(RegWrite),
	.ULAsrc(ULAsrc),
	.sampler_rx(sampler)
);
endmodule

