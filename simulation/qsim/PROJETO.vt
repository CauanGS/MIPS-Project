initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module PROJETO_vlg_vec_tst();
// constants                                           
// general purpose registers
reg Clock;
reg Reset;
// wires                                               
wire [31:0] ALU_result;
wire [6:0] HEX0;
wire [6:0] HEX1;
wire [6:0] HEX2;
wire [6:0] HEX3;
wire [6:0] HEX4;
wire [6:0] HEX5;
wire [6:0] HEX6;
wire [6:0] HEX7;
wire [31:0] PC;
wire [31:0] RD1;
wire [31:0] RD2;

wire sampler;                             

// assign statements (if any)                          
PROJETO i1 (
// port map - connection between master ports and signals/registers   
	.ALU_result(ALU_result),
	.Clock(Clock),
	.HEX0(HEX0),
	.HEX1(HEX1),
	.HEX2(HEX2),
	.HEX3(HEX3),
	.HEX4(HEX4),
	.HEX5(HEX5),
	.HEX6(HEX6),
	.HEX7(HEX7),
	.PC(PC),
	.RD1(RD1),
	.RD2(RD2),
	.Reset(Reset)
);

// Clock
always
begin
	Clock = 1'b0;
	Clock = #5000 1'b1;
	#5000;
end 

// Reset
initial
begin
	Reset = 1'b1;
	Reset = #100000 1'b0;
	Reset = #100000 1'b1;
	Reset = #100000 1'b0;
	Reset = #100000 1'b1;
	Reset = #200000 1'b0;
end 

PROJETO_vlg_sample_tst tb_sample (
	.Clock(Clock),
	.Reset(Reset),
	.sampler_tx(sampler)
);

PROJETO_vlg_check_tst tb_out(
	.ALU_result(ALU_result),
	.HEX0(HEX0),
	.HEX1(HEX1),
	.HEX2(HEX2),
	.HEX3(HEX3),
	.HEX4(HEX4),
	.HEX5(HEX5),
	.HEX6(HEX6),
	.HEX7(HEX7),
	.PC(PC),
	.RD1(RD1),
	.RD2(RD2),
	.sampler_rx(sampler)
);
endmodule

